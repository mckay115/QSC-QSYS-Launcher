{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QSC Q-Sys Launcher",
  "version": "1.1.0",
  "identifier": "com.qsc.qlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QSC Q-Sys Launcher",
        "width": 450,
        "height": 550,
        "center": true,
        "decorations": true,
        "resizable": false,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "../public/logo_OEB_icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "../public/logo_OEB_icon.ico",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": {
        "programs": ["exe"]
      }
    },
    "fs": {
      "scope": {
        "allow": [
          "$PROGRAMFILES/QSC/**"
        ]
      }
    }
  }
}
